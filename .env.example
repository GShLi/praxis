# Server deployment. Copy to a private .env file; never commit real values.
PRAXIS_DATABASE_URL=postgresql://praxis:replace-password@127.0.0.1:5432/praxis
PRAXIS_MASTER_KEY=
PRAXIS_PUBLIC_ORIGIN=http://127.0.0.1:4310
PRAXIS_BIND=127.0.0.1
PRAXIS_PORT=4310

# Local CLI / desktop credentials; independent from vendor model keys.
PRAXIS_SERVER_URL=http://127.0.0.1:4310
PRAXIS_API_KEY=
